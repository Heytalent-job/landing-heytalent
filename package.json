{
  "name": "heytalent",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de Hey Talent: landing, frontend de producto y backend.",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w @heytalent/landing",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
